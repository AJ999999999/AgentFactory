# Check text out with LF everywhere, Windows included: policy files, fixtures and
# hooks are hashed and compared byte for byte.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Config that every branch grows: merge by key, so two new keys at the end of the
# file don't conflict. The driver is set per clone by `npm run setup`.
policy/*.json merge=jsonkeys
package.json merge=jsonkeys
