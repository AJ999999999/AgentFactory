{
  "name": "agentfactory",
  "version": "0.1.0",
  "description": "MVP of a git-native multi-agent system: shared context layer, challenge process, long-running harness, Observator/Solver/Evaluator self-evolution loop, escalation policy for one human.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node --no-warnings src/demo.ts",
    "demo:challenge": "node --no-warnings src/foundation/demo.ts",
    "challenge": "node --no-warnings src/foundation/cli.ts",
    "test": "node --no-warnings --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "mcp": "node --no-warnings src/mcp-server.ts",
    "mcp:partner": "node --no-warnings src/harness/mcp.ts",
    "eval": "node --no-warnings src/eval/run.ts",
    "demo:harness": "node --no-warnings src/harness/demo.ts",
    "harness": "node --no-warnings src/harness/cli.ts",
    "memory": "node --no-warnings src/memory/cli.ts",
    "panel": "node --no-warnings src/panel/cli.ts",
    "setup": "node scripts/git/setup.mjs",
    "desk": "node --no-warnings src/desk/cli.ts"
  }
}
